  <string name="setup_guide_source_title">Fuente de la guía</string>
  <string name="setup_guide_source_helper">Elige si este proveedor usa la guía de su proveedor, tus fuentes XMLTV externas asignadas o ninguna guía.</string>
  <string name="setup_guide_policy_auto_title">Automático</string>
  <string name="setup_guide_policy_auto_description">Mantiene el comportamiento mixto actual: el XMLTV externo puede reemplazar los datos de la guía del proveedor y los canales sin coincidencia aún pueden usar la guía del proveedor como respaldo.</string>
  <string name="setup_guide_policy_external_title">Usar solo EPG externa</string>
  <string name="setup_guide_policy_external_description">Usa solo las fuentes XMLTV externas asignadas. Los canales sin coincidencia se quedan sin datos de guía.</string>
  <string name="setup_guide_policy_provider_title">Usar solo EPG del proveedor</string>
  <string name="setup_guide_policy_provider_description">Ignora las fuentes XMLTV externas asignadas a este proveedor y usa solo las rutas de guía del proveedor.</string>
  <string name="setup_guide_policy_disabled_title">Desactivar datos de guía</string>
  <string name="setup_guide_policy_disabled_description">No importa ni resuelve datos de guía para este proveedor.</string>

  <string name="setup_logo_source_title">Logotipos de canales</string>
  <string name="setup_logo_source_helper">Elige si los logotipos de canales vienen del proveedor, del icono del canal EPG coincidente o de una única fuente estricta.</string>
  <string name="setup_logo_policy_supplier_preferred_title">Logotipos del proveedor primero</string>
  <string name="setup_logo_policy_supplier_preferred_description">Usa el logotipo del proveedor si existe y, si no, el icono EPG coincidente.</string>
  <string name="setup_logo_policy_epg_preferred_title">Preferir logotipos de EPG</string>
  <string name="setup_logo_policy_epg_preferred_description">Usa primero el icono EPG coincidente y, si no, el logotipo del proveedor.</string>
  <string name="setup_logo_policy_supplier_only_title">Solo logotipos del proveedor</string>
  <string name="setup_logo_policy_supplier_only_description">Usa siempre los logotipos del proveedor para este proveedor.</string>
  <string name="setup_logo_policy_epg_only_title">Solo logotipos de EPG</string>
  <string name="setup_logo_policy_epg_only_description">Usa siempre los iconos EPG coincidentes para este proveedor.</string>

  <string name="setup_stalker_auth_title">Modo de autenticación Stalker</string>
  <string name="setup_stalker_auth_helper">La detección automática es el valor predeterminado. Cámbialo solo si el portal necesita credenciales o un inicio de sesión mixto MAG + cuenta.</string>
  <string name="setup_stalker_auth_auto_title">Detección automática</string>
  <string name="setup_stalker_auth_auto_description">Prueba primero el flujo de autenticación más probable del portal y reintenta una vez si otro modo Stalker encaja mejor.</string>
  <string name="setup_stalker_auth_mac_only_title">Solo MAC</string>
  <string name="setup_stalker_auth_mac_only_description">Usa autenticación MAC estilo MAG sin inicio de sesión de cuenta del portal.</string>
  <string name="setup_stalker_auth_mac_credentials_title">MAC + credenciales</string>
  <string name="setup_stalker_auth_mac_credentials_description">Mantiene la identidad MAG y añade las credenciales de cuenta del portal para portales más estrictos.</string>
  <string name="setup_stalker_auth_credentials_only_title">Solo credenciales</string>
  <string name="setup_stalker_auth_credentials_only_description">Usa las credenciales de cuenta del portal aunque la dirección MAC sea opcional o se ignore.</string>

