  <string name="setup_guide_source_title">Burimi i guidës</string>
  <string name="setup_guide_source_helper">Zgjidh nëse ky ofrues përdor guidën e ofruesit, burimet e jashtme XMLTV të caktuara, apo aspak guidë.</string>
  <string name="setup_guide_policy_auto_title">Auto</string>
  <string name="setup_guide_policy_auto_description">Mban sjelljen e tanishme të përzier: XMLTV i jashtëm mund të mbishkruajë të dhënat e ofruesit, ndërsa kanalet pa përputhje mund të përdorin prapë të dhënat e ofruesit.</string>
  <string name="setup_guide_policy_external_title">Vetëm EPG e jashtme</string>
  <string name="setup_guide_policy_external_description">Përdor vetëm burimet e jashtme XMLTV të caktuara. Kanalet pa përputhje mbeten pa të dhëna guide.</string>
  <string name="setup_guide_policy_provider_title">Vetëm EPG e ofruesit</string>
  <string name="setup_guide_policy_provider_description">Injoron burimet e jashtme XMLTV të caktuara për këtë ofrues dhe përdor vetëm shtigjet e guidës së ofruesit.</string>
  <string name="setup_guide_policy_disabled_title">Çaktivizo të dhënat e guidës</string>
  <string name="setup_guide_policy_disabled_description">Mos importo dhe mos përputh të dhëna guide për këtë ofrues.</string>

  <string name="setup_logo_source_title">Logot e kanaleve</string>
  <string name="setup_logo_source_helper">Zgjidh nëse logot e kanaleve vijnë nga ofruesi, nga ikona e kanalit EPG të përputhur apo nga një burim i vetëm i rreptë.</string>
  <string name="setup_logo_policy_supplier_preferred_title">Logot e ofruesit së pari</string>
  <string name="setup_logo_policy_supplier_preferred_description">Përdor logon e ofruesit kur ekziston, pastaj ikonën e kanalit EPG të përputhur.</string>
  <string name="setup_logo_policy_epg_preferred_title">Prefero logot e EPG-së</string>
  <string name="setup_logo_policy_epg_preferred_description">Përdor së pari ikonën e kanalit EPG të përputhur, pastaj logon e ofruesit.</string>
  <string name="setup_logo_policy_supplier_only_title">Vetëm logot e ofruesit</string>
  <string name="setup_logo_policy_supplier_only_description">Përdor gjithmonë logot e ofruesit për këtë ofrues.</string>
  <string name="setup_logo_policy_epg_only_title">Vetëm logot e EPG-së</string>
  <string name="setup_logo_policy_epg_only_description">Përdor gjithmonë ikonat e kanaleve EPG të përputhura për këtë ofrues.</string>

  <string name="setup_stalker_auth_title">Mënyra e autentikimit Stalker</string>
  <string name="setup_stalker_auth_helper">Zbulimi automatik është i parazgjedhur. Ndryshoje vetëm kur portali kërkon kredenciale ose hyrje të përzier MAG + llogari.</string>
  <string name="setup_stalker_auth_auto_title">Zbulim automatik</string>
  <string name="setup_stalker_auth_auto_description">Provon së pari rrjedhën më të mundshme të autentikimit të portalit dhe riprovon një herë nëse një mënyrë tjetër Stalker përshtatet më mirë.</string>
  <string name="setup_stalker_auth_mac_only_title">Vetëm MAC</string>
  <string name="setup_stalker_auth_mac_only_description">Përdor autentikim MAC në stilin MAG pa hyrje me llogari portali.</string>
  <string name="setup_stalker_auth_mac_credentials_title">MAC + kredenciale</string>
  <string name="setup_stalker_auth_mac_credentials_description">Mban identitetin MAG dhe shton kredencialet e llogarisë së portalit për portale më të rrepta.</string>
  <string name="setup_stalker_auth_credentials_only_title">Vetëm kredenciale</string>
  <string name="setup_stalker_auth_credentials_only_description">Përdor kredencialet e llogarisë së portalit edhe nëse adresa MAC është opsionale ose injorohet.</string>

