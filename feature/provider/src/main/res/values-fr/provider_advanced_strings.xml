  <string name="setup_guide_source_title">Source du guide</string>
  <string name="setup_guide_source_helper">Choisissez si ce fournisseur utilise son propre guide, vos sources XMLTV externes attribuées ou aucun guide.</string>
  <string name="setup_guide_policy_auto_title">Auto</string>
  <string name="setup_guide_policy_auto_description">Conserver le comportement mixte actuel : le XMLTV externe peut remplacer les données de guide du fournisseur, et les chaînes sans correspondance peuvent encore utiliser celles du fournisseur.</string>
  <string name="setup_guide_policy_external_title">Utiliser uniquement l’EPG externe</string>
  <string name="setup_guide_policy_external_description">Utiliser uniquement les sources XMLTV externes attribuées. Les chaînes sans correspondance restent sans données de guide.</string>
  <string name="setup_guide_policy_provider_title">Utiliser uniquement l’EPG du fournisseur</string>
  <string name="setup_guide_policy_provider_description">Ignorer les sources XMLTV externes attribuées pour ce fournisseur et utiliser uniquement les chemins de guide du fournisseur.</string>
  <string name="setup_guide_policy_disabled_title">Désactiver les données du guide</string>
  <string name="setup_guide_policy_disabled_description">Ne pas importer ni résoudre les données du guide pour ce fournisseur.</string>

  <string name="setup_logo_source_title">Logos des chaînes</string>
