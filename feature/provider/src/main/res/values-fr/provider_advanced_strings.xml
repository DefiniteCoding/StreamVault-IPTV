  <string name="setup_logo_policy_supplier_preferred_title">Logos du fournisseur en premier</string>
  <string name="setup_logo_policy_supplier_preferred_description">Utiliser le logo du fournisseur s’il existe, sinon l’icône EPG associée.</string>
  <string name="setup_logo_policy_epg_preferred_title">Privilégier les logos EPG</string>
  <string name="setup_logo_policy_epg_preferred_description">Utiliser d’abord l’icône EPG associée, sinon le logo du fournisseur.</string>
  <string name="setup_logo_policy_supplier_only_title">Logos du fournisseur uniquement</string>
  <string name="setup_logo_policy_supplier_only_description">Toujours utiliser les logos du fournisseur pour ce fournisseur.</string>
  <string name="setup_logo_policy_epg_only_title">Logos EPG uniquement</string>
  <string name="setup_logo_policy_epg_only_description">Toujours utiliser les icônes EPG associées pour ce fournisseur.</string>

  <string name="setup_stalker_auth_title">Mode d’authentification Stalker</string>
  <string name="setup_stalker_auth_helper">La détection automatique est le réglage par défaut. Ne le modifiez que si le portail exige des identifiants ou une connexion mixte MAG + compte.</string>
  <string name="setup_stalker_auth_auto_title">Détection automatique</string>
  <string name="setup_stalker_auth_auto_description">Essayer d’abord le flux d’authentification probable du portail et réessayer une fois si un autre mode Stalker convient mieux.</string>
  <string name="setup_stalker_auth_mac_only_title">MAC uniquement</string>
  <string name="setup_stalker_auth_mac_only_description">Utiliser l’authentification MAC de type MAG sans connexion à un compte du portail.</string>
  <string name="setup_stalker_auth_mac_credentials_title">MAC + identifiants</string>
  <string name="setup_stalker_auth_mac_credentials_description">Conserver l’identité MAG et ajouter les identifiants du compte du portail pour les portails plus stricts.</string>
