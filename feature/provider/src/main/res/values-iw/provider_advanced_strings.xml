  <string name="setup_guide_source_title">מקור המדריך</string>
  <string name="setup_guide_source_helper">בחרו אם ספק זה משתמש במדריך של הספק, במקורות XMLTV חיצוניים שהוקצו לכם, או ללא מדריך כלל.</string>
  <string name="setup_guide_policy_auto_title">אוטומטי</string>
  <string name="setup_guide_policy_auto_description">שמירה על ההתנהגות המעורבת הנוכחית: XMLTV חיצוני יכול לעקוף נתוני מדריך של הספק, וערוצים ללא התאמה עשויים עדיין להשתמש בגיבוי מהספק.</string>
  <string name="setup_guide_policy_external_title">EPG חיצוני בלבד</string>
  <string name="setup_guide_policy_external_description">שימוש במקורות XMLTV חיצוניים שהוקצו בלבד. ערוצים ללא התאמה נשארים ללא נתוני מדריך.</string>
  <string name="setup_guide_policy_provider_title">EPG של הספק בלבד</string>
  <string name="setup_guide_policy_provider_description">התעלמות ממקורות XMLTV חיצוניים שהוקצו לספק זה ושימוש בנתיבי המדריך של הספק בלבד.</string>
  <string name="setup_guide_policy_disabled_title">השבתת נתוני מדריך</string>
  <string name="setup_guide_policy_disabled_description">לא לייבא ולא להתאים נתוני מדריך עבור ספק זה.</string>

  <string name="setup_logo_source_title">לוגו הערוצים</string>
  <string name="setup_logo_source_helper">בחרו אם לוגו הערוצים מגיע מהספק, מסמל ערוץ ה-EPG התואם, או ממקור יחיד וקפדני.</string>
  <string name="setup_logo_policy_supplier_preferred_title">לוגו הספק קודם</string>
  <string name="setup_logo_policy_supplier_preferred_description">שימוש בלוגו הספק כשהוא קיים, ואחרת חזרה לסמל ה-EPG התואם.</string>
  <string name="setup_logo_policy_epg_preferred_title">העדפת לוגו EPG</string>
  <string name="setup_logo_policy_epg_preferred_description">שימוש בסמל ה-EPG התואם תחילה, ואחרת חזרה ללוגו הספק.</string>
  <string name="setup_logo_policy_supplier_only_title">לוגו הספק בלבד</string>
  <string name="setup_logo_policy_supplier_only_description">שימוש תמיד בלוגו הספק עבור ספק זה.</string>
  <string name="setup_logo_policy_epg_only_title">לוגו EPG בלבד</string>
  <string name="setup_logo_policy_epg_only_description">שימוש תמיד בסמלי EPG תואמים עבור ספק זה.</string>

  <string name="setup_stalker_auth_title">מצב אימות Stalker</string>
  <string name="setup_stalker_auth_helper">זיהוי אוטומטי הוא ברירת המחדל. שנו זאת רק אם הפורטל דורש פרטי התחברות או תהליך כניסה משולב של MAG וחשבון.</string>
  <string name="setup_stalker_auth_auto_title">זיהוי אוטומטי</string>
  <string name="setup_stalker_auth_auto_description">ניסיון ראשון בתהליך האימות הסביר של הפורטל, וניסיון חוזר אחד אם מצב Stalker אחר מתאים יותר.</string>
  <string name="setup_stalker_auth_mac_only_title">MAC בלבד</string>
  <string name="setup_stalker_auth_mac_only_description">שימוש באימות MAC בסגנון MAG ללא כניסה לחשבון בפורטל.</string>
  <string name="setup_stalker_auth_mac_credentials_title">MAC + פרטי התחברות</string>
  <string name="setup_stalker_auth_mac_credentials_description">שמירת זהות ה-MAG והוספת פרטי חשבון הפורטל עבור פורטלים מחמירים יותר.</string>
  <string name="setup_stalker_auth_credentials_only_title">פרטי התחברות בלבד</string>
  <string name="setup_stalker_auth_credentials_only_description">שימוש בפרטי חשבון הפורטל גם אם כתובת ה-MAC אופציונלית או שמתעלמים ממנה.</string>

