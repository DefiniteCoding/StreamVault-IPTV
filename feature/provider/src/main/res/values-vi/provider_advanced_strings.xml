  <string name="setup_guide_source_title">Nguồn hướng dẫn</string>
  <string name="setup_guide_source_helper">Chọn nhà cung cấp này dùng hướng dẫn của chính nhà cung cấp, các nguồn XMLTV bên ngoài bạn đã gán, hay không dùng hướng dẫn nào.</string>
  <string name="setup_guide_policy_auto_title">Tự động</string>
  <string name="setup_guide_policy_auto_description">Giữ hành vi kết hợp hiện tại: XMLTV bên ngoài có thể ghi đè dữ liệu hướng dẫn của nhà cung cấp, và kênh không khớp vẫn có thể dùng hướng dẫn của nhà cung cấp làm dự phòng.</string>
  <string name="setup_guide_policy_external_title">Chỉ dùng EPG bên ngoài</string>
  <string name="setup_guide_policy_external_description">Chỉ dùng các nguồn XMLTV bên ngoài đã gán. Kênh không khớp sẽ không có dữ liệu hướng dẫn.</string>
  <string name="setup_guide_policy_provider_title">Chỉ dùng EPG của nhà cung cấp</string>
  <string name="setup_guide_policy_provider_description">Bỏ qua các nguồn XMLTV bên ngoài đã gán cho nhà cung cấp này và chỉ dùng đường dẫn hướng dẫn của nhà cung cấp.</string>
  <string name="setup_guide_policy_disabled_title">Tắt dữ liệu hướng dẫn</string>
  <string name="setup_guide_policy_disabled_description">Không nhập hoặc đối chiếu dữ liệu hướng dẫn cho nhà cung cấp này.</string>

  <string name="setup_logo_source_title">Logo kênh</string>
  <string name="setup_logo_source_helper">Chọn logo kênh lấy từ nhà cung cấp, biểu tượng kênh EPG khớp, hoặc chỉ một nguồn duy nhất.</string>
  <string name="setup_logo_policy_supplier_preferred_title">Ưu tiên logo nhà cung cấp</string>
  <string name="setup_logo_policy_supplier_preferred_description">Dùng logo của nhà cung cấp nếu có, nếu không thì dùng biểu tượng EPG khớp.</string>
  <string name="setup_logo_policy_epg_preferred_title">Ưu tiên logo EPG</string>
  <string name="setup_logo_policy_epg_preferred_description">Dùng biểu tượng EPG khớp trước, nếu không thì dùng logo của nhà cung cấp.</string>
  <string name="setup_logo_policy_supplier_only_title">Chỉ logo nhà cung cấp</string>
  <string name="setup_logo_policy_supplier_only_description">Luôn dùng logo của nhà cung cấp cho nhà cung cấp này.</string>
  <string name="setup_logo_policy_epg_only_title">Chỉ logo EPG</string>
  <string name="setup_logo_policy_epg_only_description">Luôn dùng biểu tượng EPG khớp cho nhà cung cấp này.</string>

  <string name="setup_stalker_auth_title">Chế độ xác thực Stalker</string>
  <string name="setup_stalker_auth_helper">Mặc định là tự động phát hiện. Chỉ đổi khi cổng yêu cầu thông tin đăng nhập hoặc kiểu đăng nhập kết hợp MAG + tài khoản.</string>
  <string name="setup_stalker_auth_auto_title">Tự động phát hiện</string>
  <string name="setup_stalker_auth_auto_description">Thử trước luồng xác thực có khả năng cao nhất của cổng và thử lại một lần nếu chế độ Stalker khác phù hợp hơn.</string>
  <string name="setup_stalker_auth_mac_only_title">Chỉ MAC</string>
  <string name="setup_stalker_auth_mac_only_description">Dùng xác thực MAC kiểu MAG, không đăng nhập tài khoản cổng.</string>
  <string name="setup_stalker_auth_mac_credentials_title">MAC + thông tin đăng nhập</string>
  <string name="setup_stalker_auth_mac_credentials_description">Giữ danh tính MAG và thêm thông tin tài khoản cổng cho các cổng khắt khe hơn.</string>
  <string name="setup_stalker_auth_credentials_only_title">Chỉ thông tin đăng nhập</string>
  <string name="setup_stalker_auth_credentials_only_description">Dùng thông tin tài khoản cổng ngay cả khi địa chỉ MAC là tùy chọn hoặc bị bỏ qua.</string>

