  <string name="setup_logo_source_title">Csatornalogók</string>
  <string name="setup_logo_source_helper">Válassza ki, hogy a csatornalogók a beszállítótól, a párosított EPG-csatorna ikonjából vagy egyetlen szigorú forrásból származzanak.</string>
