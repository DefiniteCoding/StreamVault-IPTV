  <string name="setup_guide_source_title">Πηγή οδηγού</string>
  <string name="setup_guide_source_helper">Επιλέξτε αν αυτός ο πάροχος θα χρησιμοποιεί τον οδηγό του προμηθευτή, τις εξωτερικές πηγές XMLTV που έχετε αντιστοιχίσει ή κανέναν οδηγό.</string>
  <string name="setup_guide_policy_auto_title">Αυτόματα</string>
  <string name="setup_guide_policy_auto_description">Διατήρηση της τρέχουσας μικτής συμπεριφοράς: το εξωτερικό XMLTV μπορεί να αντικαταστήσει τα δεδομένα οδηγού του προμηθευτή και τα κανάλια χωρίς αντιστοίχιση μπορούν να χρησιμοποιούν εφεδρικά δεδομένα του προμηθευτή.</string>
  <string name="setup_guide_policy_external_title">Μόνο εξωτερικό EPG</string>
  <string name="setup_guide_policy_external_description">Χρήση μόνο των εξωτερικών πηγών XMLTV που έχουν αντιστοιχιστεί. Τα κανάλια χωρίς αντιστοίχιση μένουν χωρίς δεδομένα οδηγού.</string>
  <string name="setup_guide_policy_provider_title">Μόνο EPG προμηθευτή</string>
  <string name="setup_guide_policy_provider_description">Παράβλεψη των εξωτερικών πηγών XMLTV για αυτόν τον πάροχο και χρήση μόνο των διαδρομών οδηγού του προμηθευτή.</string>
  <string name="setup_guide_policy_disabled_title">Απενεργοποίηση δεδομένων οδηγού</string>
  <string name="setup_guide_policy_disabled_description">Να μην γίνεται εισαγωγή ή αντιστοίχιση δεδομένων οδηγού για αυτόν τον πάροχο.</string>

  <string name="setup_logo_source_title">Λογότυπα καναλιών</string>
  <string name="setup_logo_source_helper">Επιλέξτε αν τα λογότυπα καναλιών προέρχονται από τον προμηθευτή, από το εικονίδιο του αντίστοιχου καναλιού EPG ή από μία αυστηρή πηγή.</string>
  <string name="setup_logo_policy_supplier_preferred_title">Πρώτα λογότυπα προμηθευτή</string>
  <string name="setup_logo_policy_supplier_preferred_description">Χρήση του λογότυπου του προμηθευτή αν υπάρχει, αλλιώς του αντίστοιχου εικονιδίου EPG.</string>
  <string name="setup_logo_policy_epg_preferred_title">Προτίμηση λογοτύπων EPG</string>
  <string name="setup_logo_policy_epg_preferred_description">Χρήση πρώτα του αντίστοιχου εικονιδίου EPG, αλλιώς του λογότυπου του προμηθευτή.</string>
  <string name="setup_logo_policy_supplier_only_title">Μόνο λογότυπα προμηθευτή</string>
  <string name="setup_logo_policy_supplier_only_description">Πάντα χρήση των λογοτύπων του προμηθευτή για αυτόν τον πάροχο.</string>
  <string name="setup_logo_policy_epg_only_title">Μόνο λογότυπα EPG</string>
  <string name="setup_logo_policy_epg_only_description">Πάντα χρήση των αντίστοιχων εικονιδίων EPG για αυτόν τον πάροχο.</string>

  <string name="setup_stalker_auth_title">Λειτουργία ταυτοποίησης Stalker</string>
  <string name="setup_stalker_auth_helper">Η αυτόματη ανίχνευση είναι η προεπιλογή. Αλλάξτε την μόνο όταν η πύλη απαιτεί διαπιστευτήρια ή μικτή σύνδεση MAG + λογαριασμού.</string>
  <string name="setup_stalker_auth_auto_title">Αυτόματη ανίχνευση</string>
  <string name="setup_stalker_auth_auto_description">Δοκιμή πρώτα της πιθανής ροής ταυτοποίησης της πύλης και μία νέα προσπάθεια αν ταιριάζει καλύτερα άλλη λειτουργία Stalker.</string>
  <string name="setup_stalker_auth_mac_only_title">Μόνο MAC</string>
  <string name="setup_stalker_auth_mac_only_description">Χρήση ταυτοποίησης MAC τύπου MAG χωρίς σύνδεση σε λογαριασμό πύλης.</string>
  <string name="setup_stalker_auth_mac_credentials_title">MAC + διαπιστευτήρια</string>
  <string name="setup_stalker_auth_mac_credentials_description">Διατήρηση της ταυτότητας MAG και προσθήκη διαπιστευτηρίων λογαριασμού πύλης για πιο αυστηρές πύλες.</string>
  <string name="setup_stalker_auth_credentials_only_title">Μόνο διαπιστευτήρια</string>
  <string name="setup_stalker_auth_credentials_only_description">Χρήση διαπιστευτηρίων λογαριασμού πύλης ακόμη και αν η διεύθυνση MAC είναι προαιρετική ή αγνοείται.</string>

