  <string name="setup_guide_source_title">Źródło przewodnika</string>
  <string name="setup_guide_source_helper">Wybierz, czy ten dostawca ma używać przewodnika od swojego operatora, przypisanych zewnętrznych źródeł XMLTV, czy w ogóle bez przewodnika.</string>
  <string name="setup_guide_policy_auto_title">Automatycznie</string>
  <string name="setup_guide_policy_auto_description">Zachowaj obecne działanie mieszane: zewnętrzne XMLTV może nadpisać dane przewodnika operatora, a niedopasowane kanały mogą nadal korzystać z danych zapasowych operatora.</string>
  <string name="setup_guide_policy_external_title">Tylko zewnętrzne EPG</string>
  <string name="setup_guide_policy_external_description">Używaj tylko przypisanych zewnętrznych źródeł XMLTV. Niedopasowane kanały zostaną bez danych przewodnika.</string>
  <string name="setup_guide_policy_provider_title">Tylko EPG operatora</string>
  <string name="setup_guide_policy_provider_description">Ignoruj przypisane zewnętrzne źródła XMLTV dla tego dostawcy i używaj tylko ścieżek przewodnika operatora.</string>
  <string name="setup_guide_policy_disabled_title">Wyłącz dane przewodnika</string>
  <string name="setup_guide_policy_disabled_description">Nie importuj ani nie dopasowuj danych przewodnika dla tego dostawcy.</string>

  <string name="setup_logo_source_title">Logo kanałów</string>
  <string name="setup_logo_source_helper">Wybierz, czy logo kanałów pochodzą od operatora, z ikony dopasowanego kanału EPG, czy z jednego ścisłego źródła.</string>
  <string name="setup_logo_policy_supplier_preferred_title">Najpierw logo operatora</string>
  <string name="setup_logo_policy_supplier_preferred_description">Użyj logo operatora, jeśli istnieje, a w przeciwnym razie dopasowanej ikony EPG.</string>
  <string name="setup_logo_policy_epg_preferred_title">Preferuj logo z EPG</string>
  <string name="setup_logo_policy_epg_preferred_description">Najpierw użyj dopasowanej ikony EPG, a w przeciwnym razie logo operatora.</string>
  <string name="setup_logo_policy_supplier_only_title">Tylko logo operatora</string>
  <string name="setup_logo_policy_supplier_only_description">Zawsze używaj logo operatora dla tego dostawcy.</string>
  <string name="setup_logo_policy_epg_only_title">Tylko logo z EPG</string>
  <string name="setup_logo_policy_epg_only_description">Zawsze używaj dopasowanych ikon EPG dla tego dostawcy.</string>

  <string name="setup_stalker_auth_title">Tryb uwierzytelniania Stalker</string>
  <string name="setup_stalker_auth_helper">Domyślnie działa autowykrywanie. Zmień to tylko wtedy, gdy portal wymaga danych logowania lub mieszanego logowania MAG + konto.</string>
  <string name="setup_stalker_auth_auto_title">Autowykrywanie</string>
  <string name="setup_stalker_auth_auto_description">Najpierw wypróbuj najbardziej prawdopodobny sposób uwierzytelniania portalu i powtórz raz, jeśli lepiej pasuje inny tryb Stalker.</string>
  <string name="setup_stalker_auth_mac_only_title">Tylko MAC</string>
  <string name="setup_stalker_auth_mac_only_description">Użyj uwierzytelniania MAC w stylu MAG bez logowania na konto portalu.</string>
  <string name="setup_stalker_auth_mac_credentials_title">MAC + dane logowania</string>
  <string name="setup_stalker_auth_mac_credentials_description">Zachowaj tożsamość MAG i dodaj dane logowania do konta portalu dla bardziej restrykcyjnych portali.</string>
  <string name="setup_stalker_auth_credentials_only_title">Tylko dane logowania</string>
  <string name="setup_stalker_auth_credentials_only_description">Użyj danych logowania do konta portalu, nawet jeśli adres MAC jest opcjonalny lub ignorowany.</string>

